---
import type { Shader } from '../shaders';

interface Props {
  /** Карусель шейдеров: стартует со случайного, дальше листает по кругу. */
  shaders: Shader[];
  /** Соотношение сторон окошка, CSS-значение для aspect-ratio. */
  aspect?: string;
  /** Картинка-заглушка, если WebGL недоступен или ни один шейдер не собрался. */
  fallback?: string;
  /** Показывать подпись с названием текущего шейдера. */
  showTitle?: boolean;
  label?: string;
  class?: string;
}

const {
  shaders,
  aspect = '1 / 1',
  fallback,
  showTitle = false,
  label = 'Интерактивный шейдер',
  class: className = '',
} = Astro.props;
---

<div class:list={['shader-canvas', className]} style={`--shader-aspect: ${aspect}`}>
  <canvas data-shader-canvas role="img" aria-label={label}></canvas>
  <script type="application/json" data-shader-list set:html={JSON.stringify(shaders)}></script>

  {shaders.length > 1 && (
    <div class="shader-nav" data-shader-nav hidden>
      <button type="button" data-shader-step="-1" aria-label="Предыдущий шейдер">&#x2039;</button>
      <button type="button" data-shader-step="1" aria-label="Следующий шейдер">&#x203A;</button>
    </div>
  )}

  {showTitle && <div class="shader-title" data-shader-caption></div>}
  {fallback && <img class="shader-fallback" src={fallback} alt={label} hidden />}
</div>

<style>
  .shader-canvas {
    position: relative;
    width: 100%;
    aspect-ratio: var(--shader-aspect);
    overflow: hidden;
    border-radius: 4px;
    box-shadow: 0 0 4px #3a3a3a40;
    background-color: #f1f0e2;
  }

  .shader-canvas > canvas {
    display: block;
    width: 100%;
    height: 100%;
    transition: opacity 180ms ease;
  }

  /* канвас гасится в цвет бумаги на время подмены программы */
  .shader-canvas.is-swapping > canvas {
    opacity: 0;
  }

  .shader-canvas > .shader-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shader-nav {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px;
    pointer-events: none; /* тянуть мышью сам шейдер должно быть можно */
  }

  .shader-nav > button {
    pointer-events: auto;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    color: #5a3e36;
    background-color: #f1f0e2a0;
    opacity: 0.55;
    transition: opacity 150ms ease, background-color 150ms ease;
  }

  .shader-canvas:hover .shader-nav > button,
  .shader-nav > button:focus-visible {
    opacity: 1;
  }

  .shader-nav > button:hover {
    background-color: #c2947f;
  }

  .shader-title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 6px 10px;
    font-size: 0.8rem;
    color: #5a3e36;
    background-color: #f1f0e2b0;
    text-align: center;
  }

  .shader-title:empty {
    display: none;
  }
</style>

<script>
  const VERT = `
    attribute vec2 aPos;
    void main() { gl_Position = vec4(aPos, 0.0, 1.0); }
  `;

  const PRELUDE = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif
    uniform vec3  iResolution;
    uniform float iTime;
    uniform float iTimeDelta;
    uniform int   iFrame;
    uniform vec4  iMouse;
  `;

  const EPILOGUE = `
    void main() {
      vec4 color = vec4(0.0, 0.0, 0.0, 1.0);
      mainImage(color, gl_FragCoord.xy);
      gl_FragColor = vec4(color.rgb, 1.0);
    }
  `;

  const MAX_DPR = 2;
  const AUTOPLAY_MS = 7000;
  const SWAP_MS = 180;

  interface ShaderEntry {
    id: string;
    title: string;
    source: string;
  }

  interface Prepared {
    entry: ShaderEntry;
    program: WebGLProgram;
    u: Record<'resolution' | 'time' | 'delta' | 'frame' | 'mouse', WebGLUniformLocation | null>;
  }

  function compile(gl: WebGLRenderingContext, type: number, source: string) {
    const shader = gl.createShader(type)!;
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      const log = gl.getShaderInfoLog(shader);
      gl.deleteShader(shader);
      throw new Error(log ?? 'shader compile failed');
    }
    return shader;
  }

  function buildProgram(gl: WebGLRenderingContext, fragmentBody: string, derivatives: boolean) {
    const header = derivatives ? '#extension GL_OES_standard_derivatives : enable\n' : '';
    const vs = compile(gl, gl.VERTEX_SHADER, VERT);
    const fs = compile(gl, gl.FRAGMENT_SHADER, header + PRELUDE + fragmentBody + EPILOGUE);
    const program = gl.createProgram()!;
    gl.attachShader(program, vs);
    gl.attachShader(program, fs);
    gl.bindAttribLocation(program, 0, 'aPos');
    gl.linkProgram(program);
    gl.deleteShader(vs);
    gl.deleteShader(fs);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      const log = gl.getProgramInfoLog(program);
      gl.deleteProgram(program);
      throw new Error(log ?? 'program link failed');
    }
    return program;
  }

  function showFallback(root: HTMLElement, reason: string) {
    console.warn('[ShaderCanvas]', reason);
    const img = root.querySelector<HTMLImageElement>('.shader-fallback');
    if (img) {
      img.hidden = false;
      root.querySelector('canvas')?.remove();
    }
    root.querySelector<HTMLElement>('[data-shader-nav]')?.remove();
  }

  /** Случайный порядок: старт со случайного шейдера, дальше листаем по кругу. */
  function shuffled<T>(items: T[]) {
    const copy = items.slice();
    for (let i = copy.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
  }

  function init(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>('canvas[data-shader-canvas]');
    const listJson = root.querySelector('script[data-shader-list]')?.textContent;
    const list: ShaderEntry[] = listJson ? JSON.parse(listJson) : [];
    if (!canvas || list.length === 0) return;

    const gl =
      canvas.getContext('webgl', { alpha: false, antialias: false, depth: false, stencil: false }) ??
      (canvas.getContext('experimental-webgl') as WebGLRenderingContext | null);

    if (!gl) {
      showFallback(root, 'WebGL недоступен');
      return;
    }

    const derivatives = !!gl.getExtension('OES_standard_derivatives');
    const order = shuffled(list);
    const cache = new Map<string, Prepared | null>(); // null — шейдер не собрался

    /** Ленивая сборка: компилируем шейдер, только когда до него дошла очередь. */
    function prepare(entry: ShaderEntry): Prepared | null {
      const cached = cache.get(entry.id);
      if (cached !== undefined) return cached;

      let prepared: Prepared | null = null;
      try {
        const program = buildProgram(gl!, entry.source, derivatives);
        prepared = {
          entry,
          program,
          u: {
            resolution: gl!.getUniformLocation(program, 'iResolution'),
            time: gl!.getUniformLocation(program, 'iTime'),
            delta: gl!.getUniformLocation(program, 'iTimeDelta'),
            frame: gl!.getUniformLocation(program, 'iFrame'),
            mouse: gl!.getUniformLocation(program, 'iMouse'),
          },
        };
      } catch (err) {
        console.warn(`[ShaderCanvas] шейдер "${entry.id}" не собрался:`, err);
      }

      cache.set(entry.id, prepared);
      return prepared;
    }

    /** Первый собирающийся шейдер начиная с from — битые молча пропускаем. */
    function findPlayable(from: number, dir: number) {
      for (let i = 0; i < order.length; i++) {
        const index = (((from + i * dir) % order.length) + order.length) % order.length;
        if (prepare(order[index])) return index;
      }
      return -1;
    }

    let index = findPlayable(0, 1);
    if (index < 0) {
      showFallback(root, 'ни один шейдер не собрался');
      return;
    }
    let current = cache.get(order[index].id) as Prepared;

    const buffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

    // iMouse по правилам Shadertoy: xy — текущая точка, zw — точка нажатия (отрицательна, пока не нажали)
    const mouse = { x: 0, y: 0, downX: -1, downY: -1 };
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const baseLabel = canvas.getAttribute('aria-label') ?? '';
    const caption = root.querySelector<HTMLElement>('[data-shader-caption]');

    let dpr = 1;
    let time = 0;
    let frame = 0;
    let last = 0;
    let raf = 0;
    let timer = 0;
    let swapTimer = 0;
    let visible = false;
    let contextLost = false;

    function apply(prepared: Prepared) {
      current = prepared;
      time = 0;
      frame = 0;
      last = 0;
      gl!.useProgram(prepared.program);
      canvas!.dataset.shaderId = prepared.entry.id;
      canvas!.setAttribute('aria-label', `${baseLabel}: ${prepared.entry.title}`);
      if (caption) caption.textContent = prepared.entry.title;
      tick();
    }

    function goTo(next: number) {
      if (next < 0 || next === index) return;
      index = next;
      const prepared = cache.get(order[index].id) as Prepared;

      if (reduceMotion.matches) {
        apply(prepared);
        return;
      }
      if (swapTimer) window.clearTimeout(swapTimer);
      root.classList.add('is-swapping');
      swapTimer = window.setTimeout(() => {
        swapTimer = 0;
        apply(prepared);
        root.classList.remove('is-swapping');
      }, SWAP_MS);
    }

    function step(dir: number) {
      goTo(findPlayable(index + dir, dir));
      scheduleNext();
    }

    function clearTimer() {
      if (timer) window.clearTimeout(timer);
      timer = 0;
    }

    function scheduleNext() {
      clearTimer();
      if (!visible || contextLost || order.length < 2 || reduceMotion.matches) return;
      timer = window.setTimeout(() => step(1), AUTOPLAY_MS);
    }

    function pointerPos(event: PointerEvent) {
      const rect = canvas!.getBoundingClientRect();
      return {
        x: (event.clientX - rect.left) * dpr,
        y: (rect.bottom - event.clientY) * dpr, // ось Y снизу вверх, как в GLSL
      };
    }

    canvas.addEventListener('pointerdown', (event) => {
      const pos = pointerPos(event);
      mouse.x = mouse.downX = pos.x;
      mouse.y = mouse.downY = pos.y;
      canvas.setPointerCapture(event.pointerId);
      clearTimer(); // пока крутят шейдер руками, не подменяем его под курсором
      tick();
    });
    canvas.addEventListener('pointermove', (event) => {
      const pos = pointerPos(event);
      mouse.x = pos.x;
      mouse.y = pos.y;
      tick();
    });
    const release = () => {
      mouse.downX = -Math.abs(mouse.downX);
      mouse.downY = -Math.abs(mouse.downY);
      scheduleNext();
      tick();
    };
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);

    const nav = root.querySelector<HTMLElement>('[data-shader-nav]');
    if (nav && order.length > 1) {
      nav.hidden = false; // без JS стрелки бесполезны, поэтому показываем их только отсюда
      nav.querySelectorAll<HTMLButtonElement>('[data-shader-step]').forEach(button => {
        button.addEventListener('click', () => step(Number(button.dataset.shaderStep)));
      });
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
      const width = Math.max(1, Math.round(canvas!.clientWidth * dpr));
      const height = Math.max(1, Math.round(canvas!.clientHeight * dpr));
      if (canvas!.width !== width || canvas!.height !== height) {
        canvas!.width = width;
        canvas!.height = height;
      }
    }

    function render(now: number) {
      raf = 0;
      if (contextLost) return;

      const delta = last ? Math.min((now - last) / 1000, 1 / 15) : 1 / 60;
      last = now;
      if (!reduceMotion.matches) time += delta;

      resize();
      gl!.viewport(0, 0, canvas!.width, canvas!.height);
      gl!.uniform3f(current.u.resolution, canvas!.width, canvas!.height, 1);
      gl!.uniform1f(current.u.time, time);
      gl!.uniform1f(current.u.delta, delta);
      gl!.uniform1i(current.u.frame, frame);
      gl!.uniform4f(current.u.mouse, mouse.x, mouse.y, mouse.downX, mouse.downY);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
      frame++;

      if (visible && !reduceMotion.matches) raf = requestAnimationFrame(render);
    }

    function tick() {
      if (!raf && !contextLost) raf = requestAnimationFrame(render);
    }

    function play() {
      if (visible || contextLost) return;
      visible = true;
      last = 0;
      tick();
      scheduleNext();
    }

    function pause() {
      visible = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      clearTimer();
    }

    canvas.addEventListener('webglcontextlost', (event) => {
      event.preventDefault();
      contextLost = true;
      pause();
      showFallback(root, 'WebGL-контекст потерян');
    });

    new ResizeObserver(tick).observe(canvas);
    new IntersectionObserver(
      ([entry]) => (entry.isIntersecting && !document.hidden ? play() : pause()),
      { threshold: 0 }
    ).observe(canvas);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pause();
      else if (canvas.getBoundingClientRect().bottom > 0) play();
    });
    reduceMotion.addEventListener('change', () => { tick(); scheduleNext(); });

    apply(current);
  }

  document.querySelectorAll<HTMLElement>('.shader-canvas').forEach(init);
</script>
